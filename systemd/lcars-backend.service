[Unit]
Description=LCARS local monitoring backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lcars
Group=lcars
WorkingDirectory=/opt/lcars-monitor
ExecStart=/opt/lcars-monitor/scripts/run-backend.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
LoadCredential=jellyfin.env:/etc/lcars-monitor/jellyfin.env
RuntimeDirectory=lcars
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

